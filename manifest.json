{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "VALPRO",
    "author": "VALPRO LABS",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.199.0.15",
    "description": "Minimal VALPRO Overwolf desktop starter.",
    "icon": "assets/icons/IconMouseOver.png",
    "icon_gray": "assets/icons/IconMouseNormal.png",
    "window_icon": "assets/icons/IconMouseOver.png"
  },
  "permissions": [],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "dist/windows/background/background.html",
        "debug_url": "http://127.0.0.1:5173/background/background.html",
        "background_optimization": true,
        "is_background_page": true
      },
      "desktop": {
        "file": "dist/windows/desktop/desktop.html",
        "debug_url": "http://127.0.0.1:5173/desktop/desktop.html",
        "desktop_only": true,
        "native_window": true,
        "transparent": false,
        "resizable": true,
        "use_os_windowing": true,
        "show_maximize": true,
        "show_in_taskbar": true,
        "override_on_update": true,
        "size": {
          "width": 720,
          "height": 480
        },
        "min_size": {
          "width": 640,
          "height": 420
        }
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
