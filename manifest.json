{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Valpro Labs Desktop",
    "author": "Valpro Labs",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.199.0.15",
    "description": "Valpro Labs Overwolf Native desktop app starter.",
    "icon": "assets/icons/IconMouseOver.png",
    "icon_gray": "assets/icons/IconMouseNormal.png",
    "window_icon": "assets/icons/IconMouseOver.png"
  },
  "permissions": [
    "GameInfo"
  ],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "windows/background/background.html",
        "background_optimization": true,
        "is_background_page": true
      },
      "desktop": {
        "file": "windows/desktop/desktop.html",
        "desktop_only": true,
        "native_window": true,
        "transparent": false,
        "resizable": true,
        "show_in_taskbar": true,
        "override_on_update": true,
        "size": {
          "width": 960,
          "height": 620
        },
        "min_size": {
          "width": 760,
          "height": 480
        }
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}

