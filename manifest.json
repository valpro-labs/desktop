{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "VALPRO",
    "author": "VALPRO LABS",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.199.0.15",
    "description": "VALPRO Overwolf Native desktop app.",
    "icon": "assets/icons/IconMouseOver.png",
    "icon_gray": "assets/icons/IconMouseNormal.png",
    "window_icon": "assets/icons/IconMouseOver.png"
  },
  "permissions": [
    "GameInfo",
    "Streaming",
    "Tray"
  ],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640]
    },
    "game_events": [21640],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [21640],
          "wait_for_stable_framerate": 30
        },
        "start_minimized": true
      }
    ],
    "start_window": "background",
    "windows": {
      "background": {
        "file": "dist/windows/background/background.html",
        "background_optimization": true,
        "is_background_page": true
      },
      "desktop": {
        "file": "dist/windows/desktop/desktop.html",
        "desktop_only": true,
        "native_window": true,
        "transparent": false,
        "resizable": true,
        "show_in_taskbar": true,
        "override_on_update": true,
        "size": {
          "width": 960,
          "height": 620
        },
        "min_size": {
          "width": 760,
          "height": 480
        }
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
